# Hostinger adds these after Database -> Connect -> Supabase. For manual setup,
# copy the Project URL and server-side service-role key from Supabase.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-key

# Required by the PHP API. Generate a long random value for production.
JWT_SECRET=replace-with-a-long-random-secret
