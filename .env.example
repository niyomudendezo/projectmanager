# Preferred: copy the URI from Supabase -> Connect -> Transaction pooler.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Required by the PHP API. Generate a long random value for production.
JWT_SECRET=replace-with-a-long-random-secret

# Alternative to DATABASE_URL:
# SUPABASE_DB_HOST=aws-0-REGION.pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.PROJECT_REF
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_DB_SSLMODE=require
